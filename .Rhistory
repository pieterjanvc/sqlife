split_sql_statements <- function(sql) {
statements <- character()
statement <- ""
in_single_quote <- FALSE
in_double_quote <- FALSE
i <- 1
while (i <= nchar(sql)) {
c <- substr(sql, i, i)
if (c == "'" && !in_double_quote) {
# Handle escaped single quotes ''
if (in_single_quote && substr(sql, i + 1, i + 1) == "'") {
statement <- paste0(statement, "''")
i <- i + 2
next
}
in_single_quote <- !in_single_quote
statement <- paste0(statement, c)
} else if (c == '"' && !in_single_quote) {
# Handle escaped double quotes ""
if (in_double_quote && substr(sql, i + 1, i + 1) == '"') {
statement <- paste0(statement, '""')
i <- i + 2
next
}
in_double_quote <- !in_double_quote
statement <- paste0(statement, c)
} else if (c == ";" && !in_single_quote && !in_double_quote) {
statements <- c(statements, trimws(statement))
statement <- ""
} else {
statement <- paste0(statement, c)
}
i <- i + 1
}
if (nchar(trimws(statement)) > 0) {
statements <- c(statements, trimws(statement))
}
return(statements)
}
sqlFile
split_sql_statements(sqlFile)
#' Extract all statements from an SQLite file
#'
#' @param file An SQLite file
#'
#' @returns A vector of individual SQLite statements in the same order as in the file
#' @export
#'
sql_statements <- function(file) {
# Read file and remove comments
sql <- readLines(schema)
sql <- sub("--.*", "", sql) |>
paste(collapse = "")
statements <- character()
statement <- ""
in_single_quote <- FALSE
in_double_quote <- FALSE
i <- 1
while (i <= nchar(sql)) {
c <- substr(sql, i, i)
if (c == "'" && !in_double_quote) {
# Handle escaped single quotes ''
if (in_single_quote && substr(sql, i + 1, i + 1) == "'") {
statement <- paste0(statement, "''")
i <- i + 2
next
}
in_single_quote <- !in_single_quote
statement <- paste0(statement, c)
} else if (c == '"' && !in_single_quote) {
# Handle escaped double quotes ""
if (in_double_quote && substr(sql, i + 1, i + 1) == '"') {
statement <- paste0(statement, '""')
i <- i + 2
next
}
in_double_quote <- !in_double_quote
statement <- paste0(statement, c)
} else if (c == ";" && !in_single_quote && !in_double_quote) {
statements <- c(statements, trimws(statement))
statement <- ""
} else {
statement <- paste0(statement, c)
}
i <- i + 1
}
if (nchar(trimws(statement)) > 0) {
statements <- c(statements, trimws(statement))
}
return(statements)
}
